it('filters {{pluralName}}', function () {
    $value = {{modelName}}::factory()->count(3)->create()->first()->getRawOriginal('{{filterField}}');

    $result = $this->service->paginate(['filter' => ['{{filterField}}' => $value]]);

    expect($result->total())->toBe({{modelName}}::where('{{filterField}}', $value)->count());
});

