<?php

use App\Models\{{modelName}};{{relatedImports}}{{userImport}}
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Arr;

uses(RefreshDatabase::class);
{{userSetup}}
it('lists {{pluralName}}', function () {
    {{modelName}}::factory()->count(3)->create();

    $response = {{actingAs}}$this->getJson('/api/{{pluralName}}?per_page=2');

    $response->assertStatus(200)
        ->assertJsonCount(2, 'data')
        ->assertJsonPath('meta.total', 3);
});

it('filters {{pluralName}}', function () {
    $value = {{modelName}}::factory()->count(3)->create()->first()->getRawOriginal('{{filterField}}');

    $response = {{actingAs}}$this->getJson('/api/{{pluralName}}?'.http_build_query(['filter' => ['{{filterField}}' => $value]]));

    $response->assertStatus(200)
        ->assertJsonPath('meta.total', {{modelName}}::where('{{filterField}}', $value)->count());
});

it('sorts {{pluralName}}', function () {
    {{modelName}}::factory()->count(3)->create();

    $response = {{actingAs}}$this->getJson('/api/{{pluralName}}?sort={{primaryKey}}');

    $response->assertStatus(200)
        {{sortAssertion}};
});

it('creates a {{modelNameLower}}', function () {
{{createRelatedModels}}    $data = [
{{relatedFkFields}}{{requestFields}}
    ];

    $response = {{actingAs}}$this->postJson('/api/{{pluralName}}', $data);

    $response->assertStatus(201);
    {{assertFields}}
});

it('shows a {{modelNameLower}}', function () {
    ${{modelNameLower}} = {{modelName}}::factory()->create();

    $response = {{actingAs}}$this->getJson("/api/{{pluralName}}/{${{modelNameLower}}->getKey()}");

    $response->assertStatus(200)
        {{showIdAssertion}};
});

it('updates a {{modelNameLower}}', function () {
    ${{modelNameLower}} = {{modelName}}::factory()->create();
    $data = [
{{updateRelatedFkFields}}{{requestFields}}
    ];

    $response = {{actingAs}}$this->putJson("/api/{{pluralName}}/{${{modelNameLower}}->getKey()}", $data);

    $response->assertStatus(200);
    {{updateAssertFields}}
});

it('patches a {{modelNameLower}}', function () {
    ${{modelNameLower}} = {{modelName}}::factory()->create()->fresh();

    $response = {{actingAs}}$this->patchJson("/api/{{pluralName}}/{${{modelNameLower}}->getKey()}", [{{patchFields}}]);

    $response->assertStatus(200);{{patchAssertion}}
    expect(Arr::except(${{modelNameLower}}->fresh()->getAttributes(), [{{patchedColumns}}]))
        ->toBe(Arr::except(${{modelNameLower}}->getAttributes(), [{{patchedColumns}}]));
});

it('deletes a {{modelNameLower}}', function () {
    ${{modelNameLower}} = {{modelName}}::factory()->create();

    $response = {{actingAs}}$this->deleteJson("/api/{{pluralName}}/{${{modelNameLower}}->getKey()}");

    $response->assertStatus(204);
    {{deleteAssertion}}
});{{softDeleteTests}}

it('validates required fields on create', function () {
    $response = {{actingAs}}$this->postJson('/api/{{pluralName}}', []);

    $response->assertStatus(422);
});
