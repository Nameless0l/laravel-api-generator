<?php

declare(strict_types=1);

namespace App\Services;

use App\DTO\{{modelName}}DTO;
use App\Models\{{modelName}};
use Illuminate\Contracts\Pagination\LengthAwarePaginator;

class {{modelName}}Service
{
    private const FILTERS = [{{allowedFilters}}];

    private const SORTS = [{{allowedSorts}}];

    /**
     * @param  array<string, mixed>  $query  filter[field]=value, sort=field,-field, page, per_page
     */
    public function paginate(array $query = []): LengthAwarePaginator
    {
        $builder = {{modelName}}::query();

        foreach ((array) ($query['filter'] ?? []) as $field => $value) {
            if (in_array($field, self::FILTERS, true)) {
                $builder->where($field, $value);
            }
        }

        $sorts = array_filter(
            explode(',', is_string($query['sort'] ?? null) ? $query['sort'] : ''),
            fn (string $sort) => in_array(ltrim($sort, '-'), self::SORTS, true)
        );

        foreach ($sorts ?: ['-{{primaryKey}}'] as $sort) {
            $builder->orderBy(ltrim($sort, '-'), str_starts_with($sort, '-') ? 'desc' : 'asc');
        }

        $perPage = is_numeric($query['per_page'] ?? null) ? min(max((int) $query['per_page'], 1), {{maxPerPage}}) : {{perPage}};

        return $builder->paginate($perPage, ['*'], 'page', max((int) ($query['page'] ?? 1), 1))->withQueryString();
    }

    public function create({{modelName}}DTO $dto): {{modelName}}
    {
        return {{modelName}}::create($dto->toArray());
    }

    public function find(int|string $id): {{modelName}}
    {
        return {{modelName}}::findOrFail($id);
    }

    public function update({{modelName}} ${{modelNameLower}}, {{modelName}}DTO $dto): {{modelName}}
    {
        ${{modelNameLower}}->update($dto->toArray());

        return ${{modelNameLower}}->fresh();
    }

    public function delete({{modelName}} ${{modelNameLower}}): bool
    {
        return ${{modelNameLower}}->delete();
    }{{softDeleteMethods}}
}
