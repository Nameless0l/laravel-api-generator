    public function handle(Request $request, {{modelName}}Service ${{service}}): ResponseFactory
    {
        Gate::authorize('create', {{modelClass}}::class);

        ${{variable}} = ${{service}}->create({{modelName}}DTO::fromArray($request->validate($this->rules())));

        return Response::structured((new {{modelName}}Resource(${{variable}}))->response()->getData(true));
    }

